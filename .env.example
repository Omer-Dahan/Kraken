# Required Telegram credentials
API_ID=
API_HASH=
BOT_TOKEN=
ALLOWED_USER_IDS=

# Optional Userbot session
SESSION_STRING=
SESSION_PATH=userbot

# Download behavior
DOWNLOAD_CONNECTIONS=10
NON_PREMIUM_CONNECTIONS=4
DOWNLOAD_QUEUE_CONCURRENCY=2
BOT_QUEUE_CONCURRENCY=1
QUIET_GROUP_SIZE=8
BATCH_DEBOUNCE_SECONDS=4

# qBittorrent and Jellyfin
# qBittorrent must allow unauthenticated access from the bot. In qBittorrent's Web UI:
# Options -> Web UI -> Authentication -> "Bypass authentication for clients on localhost".
# If the bot runs on a different host, configure QBIT_URL accordingly.
QBIT_URL=http://localhost:8080
# JELLYFIN_URL is where the bot itself calls the API (same VM, so loopback).
# JELLYFIN_PUBLIC_URL is what goes into the watch links sent to Telegram, so it has to be an
# address the phone/laptop opening them can actually reach - not localhost.
JELLYFIN_URL=http://localhost:8096
JELLYFIN_PUBLIC_URL=
# Jellyfin Dashboard -> Advanced -> API Keys. Empty disables the 🍿 screen and watch links.
JELLYFIN_API_KEY=
JELLYFIN_LOOKUP_ATTEMPTS=6
JELLYFIN_LOOKUP_DELAY=10
JELLYFIN_REFRESH_COOLDOWN=45

# Media folders
MEDIA_ROOT=/media
STAGING_DIR=/media/.incoming

# Interface and matching
FB_PAGE_SIZE=10
TORRENTS_PAGE_SIZE=6
TORRENT_HASH_PREFIX_LEN=8
SIMILARITY_MENTION_THRESHOLD=75
